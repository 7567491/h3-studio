# H3 Studio Backend — example secrets file
# Copy to .env and fill in real values. .env is git-ignored.
#
# ⚠️ 部署时全部必填,默认值留空避免泄露内网拓扑。

# === ComfyUI backend ===
# 你的 GPU 主机地址,跑着 H3 模型套件的 ComfyUI 实例
# 例: https://your-comfyui-host:8448  (留空 = 后端启动报 ConfigError)
COMFYUI_BASE_URL=
COMFYUI_USERNAME=
COMFYUI_PASSWORD=

# === Access control ===
# Frontend PassGate password (SHA256 compared server-side)
H3_ACCESS_PASS=change_me
# Allowed submitters (comma-separated Feishu user_id or system usernames)
H3_ALLOWED_SUBMITTERS=
# Per-IP submit rate limit (seconds)
H3_RATE_LIMIT=300

# === Local paths ===
# Absolute path to your prompt library (override only if you keep one elsewhere)
PROMPT_LIBRARY_DIR=./prompts
# Absolute path where finished videos are saved (also served by nginx /media/)
H3_UPLOADS_DIR=./uploads

# === Service ===
SERVICE_HOST=127.0.0.1
SERVICE_PORT=18893

# === CORS ===
# 逗号分隔的允许跨域源 (前端域名,不含路径)。
# 留空 = 仅 http://localhost:3000 (开发模式)。
# 生产必须设为你自己的前端域名,例如:
# CORS_ORIGINS=https://your-domain.example,https://staging.your-domain.example
CORS_ORIGINS=

# === GPU 真实状态采集 (SSH 出站) ===
# 必填:你的远端 RTX 服务器 SSH 入口。留空 = GPU 状态采集禁用,不阻塞提交。
RTX_SSH_HOST=
RTX_SSH_USER=
# SSH 密码(含 @ 必须引号包); 推荐用 key,免去密码轮换麻烦
RTX_SSH_PASS=
RTX_SSH_KEY=
# RTX 主机本地 vLLM 端点(从 RTX 上 curl 本机 127.0.0.1)
RTX_VLLM_API_HOST=http://127.0.0.1:8000
RTX_SSH_TIMEOUT_S=5

# =====================================================================
# === LLM Prompt 扩写 (通用,可选) ===
# =====================================================================
# 支持任何 OpenAI 兼容 / Anthropic / 自定义 endpoint。
# 留空时:expand_prompt 静默降级为 no-op,后端其余功能正常。
#
# ---- Provider 协议选择 ----
# LLM_PROVIDER 取值:
#   openai    : OpenAI 兼容协议 (OpenAI / DeepSeek / Ollama / vLLM / lm-studio / 一加 / gemini-openai)
#   anthropic : Anthropic native (claude-3-5-sonnet-latest, claude-opus-4-0)
#   custom    : 与 openai 一致,但 base_url 完全自定义
#
# ---- 常用 Provider 模板 ----
#
# 1) OpenAI:
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_API_KEY=sk-...
#    LLM_TEXT_MODEL=gpt-4o
#    LLM_VISION_MODEL=gpt-4o
#
# 2) Anthropic Claude:
#    LLM_PROVIDER=anthropic
#    LLM_BASE_URL=https://api.anthropic.com
#    LLM_API_KEY=sk-ant-...
#    LLM_TEXT_MODEL=claude-3-5-sonnet-latest
#    LLM_VISION_MODEL=claude-3-5-sonnet-latest
#
# 3) 一加 (OpenAI 兼容):
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=https://api.minimaxi.com/v1
#    LLM_API_KEY=...
#    LLM_TEXT_MODEL=MiniMax-M3
#    LLM_VISION_MODEL=MiniMax-Text-01
#
# 4) DeepSeek:
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=https://api.deepseek.com/v1
#    LLM_API_KEY=sk-...
#    LLM_TEXT_MODEL=deepseek-chat
#    LLM_VISION_MODEL=  (留空 = 禁用 vision)
#
# 5) 本地 Ollama:
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=http://127.0.0.1:11434/v1
#    LLM_API_KEY=ollama
#    LLM_TEXT_MODEL=qwen2.5:32b
#    LLM_VISION_MODEL=llava:latest
#
# 6) 本地 vLLM (OpenAI 兼容):
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=http://127.0.0.1:8000/v1
#    LLM_API_KEY=EMPTY
#    LLM_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct
#    LLM_VISION_MODEL=  (留空 = 禁用 vision)
#
# ---- 高级配置 (一般不动) ----
# LLM_VISION_ENDPOINT=chat/completions  # vision 用别的 endpoint 时改这里
# LLM_TEXT_ENDPOINT=chat/completions    # text 用别的 endpoint 时改这里 (如 minimax 的 text/chatcompletion_v2)

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEXT_MODEL=
LLM_VISION_MODEL=